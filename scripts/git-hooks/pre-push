#!/usr/bin/env bash
set -euo pipefail

# REQ-QUALITY-004, REQ-RELEASE-041, RBOT-QUAL-001

zero="0000000000000000000000000000000000000000"
last=""
checked=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    [ -z "$(git rev-list -n 1 "$local_sha" --not --remotes)" ] && continue
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  scripts/platform/conventions.sh commits --range "$range"
  last="$local_sha"
  checked=1
done

if [ "$checked" -eq 0 ]; then
  printf '[pre-push] неотправленных коммитов нет\n'
  exit 0
fi

if [ -n "$last" ] && scripts/platform/conventions.sh attested --commit "$last" > /dev/null 2>&1; then
  printf '[pre-push] расписка о verify на %s есть: check не повторяется\n' "${last:0:8}"
  exec scripts/platform/conventions.sh docs-check
fi

printf '[pre-push] mise run check\n'
exec mise run check
