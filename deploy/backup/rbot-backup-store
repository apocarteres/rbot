#!/bin/sh
# RBOT-OPS-009, REQ-BACKUPS-003, REQ-BACKUPS-008
set -eu
dir=/srv/backups/rbot
keep=5
name_ok() {
  printf '%s' "$1" | grep -Eq '^rbot-[0-9]{8}T[0-9]{6}Z\.dump$'
}
set -- ${SSH_ORIGINAL_COMMAND:-}
case "${1:-}" in
  put)
    name_ok "${2:-}" || { echo "имя копии не принято" >&2; exit 2; }
    tmp="$dir/.incoming-$2"
    cat > "$tmp"
    [ -s "$tmp" ] || { rm -f "$tmp"; echo "пустая копия" >&2; exit 2; }
    mv "$tmp" "$dir/$2"
    ls -1 "$dir" | grep -E '^rbot-[0-9]{8}T[0-9]{6}Z\.dump$' | sort -r | tail -n +$((keep + 1)) | while read -r old; do rm -f "$dir/$old"; done
    ;;
  get)
    name_ok "${2:-}" || { echo "имя копии не принято" >&2; exit 2; }
    cat "$dir/$2"
    ;;
  latest)
    ls -1 "$dir" | grep -E '^rbot-[0-9]{8}T[0-9]{6}Z\.dump$' | sort -r | head -n 1
    ;;
  list)
    ls -1 "$dir" | grep -E '^rbot-[0-9]{8}T[0-9]{6}Z\.dump$' | sort
    ;;
  *)
    echo "команды: put <копия>, get <копия>, latest, list" >&2
    exit 2
    ;;
esac
