{
  "sources": [
    "src",
    "frontend/projects",
    "frontend/shared",
    "scripts"
  ],
  "exclude": [
    "/.platform/",
    "/frontend/.angular/",
    "/frontend/dist/"
  ],
  "ticketPrefix": "RBOT",
  "release": {
    "scheme": "date",
    "openQuestions": {
      "remind": 4,
      "require": 15
    }
  },
  "modal": {
    "selector": "[aria-modal]",
    "backdrop": ".veil"
  },
  "deployment": {
    "environments": [
      "qa",
      "production"
    ],
    "components": {
      "backend": {
        "artifact": "target/rbot-1.0.0.jar"
      },
      "frontend-admin": {
        "artifact": "frontend/dist/admin/browser"
      },
      "frontend-bot": {
        "artifact": "frontend/dist/bot/browser"
      },
      "web-headers": {
        "artifact": "deploy/nginx/rbot-headers.conf",
        "install": "/etc/nginx/snippets/rbot-headers.conf",
        "verify": "scripts/deploy/parse-nginx.sh {} server"
      },
      "web-site": {
        "artifact": "deploy/nginx/rbot.conf",
        "install": "/etc/nginx/sites-available/rbot",
        "verify": "scripts/deploy/parse-nginx.sh {}"
      },
      "unit-backend": {
        "artifact": "deploy/systemd/rbot@.service",
        "install": "/etc/systemd/system/rbot@.service",
        "verify": "systemd-analyze verify {}"
      },
      "web-stand": {
        "artifact": "docker/frontend-runtime/nginx.conf"
      },
      "unit-backup": {
        "artifact": "deploy/systemd/rbot-backup.service",
        "install": "/etc/systemd/system/rbot-backup.service",
        "verify": "systemd-analyze verify {}"
      },
      "timer-backup": {
        "artifact": "deploy/systemd/rbot-backup.timer",
        "install": "/etc/systemd/system/rbot-backup.timer",
        "verify": "systemd-analyze verify {}",
        "enable": true
      },
      "unit-telegram-tunnel": {
        "artifact": "deploy/systemd/rbot-telegram-tunnel.service",
        "install": "/etc/systemd/system/rbot-telegram-tunnel.service",
        "verify": "systemd-analyze verify {}",
        "enable": true
      }
    },
    "withoutDowntime": {
      "migrations": "src/main/resources/db/changelog/db.changelog-master.yaml",
      "instances": [
        "8091",
        "8092"
      ]
    }
  },
  "commitRuleSince": "b8c22965ecf1741dd533b250c047f40b8239fb15",
  "backups": {
    "sets": {
      "database": {
        "kind": "database",
        "every": "24h",
        "keep": "5d",
        "store": "bones",
        "receipt": "/var/lib/rbot/backups/database.receipt.json",
        "timer": "rbot-backup.timer"
      }
    },
    "restoreRecord": "/var/lib/rbot/backups/restored.json",
    "restoreEvery": "90d"
  },
  "clockAllowlist": [
    "frontend/shared/system-clock.ts"
  ]
}
